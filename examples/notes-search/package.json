{
  "name": "notes-search",
  "version": "1.0.0",
  "private": true,
  "description": "Semantic search over a folder of notes, using vdblite and a local embedding model",
  "type": "module",
  "bin": {
    "notes": "./cli.js"
  },
  "scripts": {
    "index": "node cli.js index",
    "search": "node cli.js search"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "vdblite": "file:../../bindings/node"
  },
  "overrides": {
    "onnxruntime-node": "1.22.0"
  }
}
